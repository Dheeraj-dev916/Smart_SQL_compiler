# Optional. Without these, history and preferences are stored in the browser (localStorage).
# Use the project's *anon/publishable* key only. Never put a service-role key in a VITE_ variable:
# everything prefixed VITE_ is bundled into the public front-end.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: port of the sandbox execution API (server/index.mjs). Default 8787.
# PORT=8787

# Optional AI Studio (server side only; never prefix with VITE_). Without a key the AI features show "not set up".
# GEMINI_API_KEY=            # Google key (AI Studio "AIza..." or Google Cloud "AQ....")
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # alternative provider (any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# AI_PROVIDER=gemini         # optional: gemini | anthropic | openai (auto-detected from the key)
# AI_MODEL=                  # optional override, default gemini-2.5-flash / claude-sonnet-5-5 / gpt-4o-mini
# AI_API_KEY=              # any other OpenAI-compatible service: set these three together
# AI_BASE_URL=https://example.com/v1
